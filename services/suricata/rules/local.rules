# Local validation rule — triggers on ANY HTTP traffic regardless of direction.
# Used by validate_detection_stack.sh to prove the full Suricata alert pipeline works
# (ET Open rules only match HOME_NET <-> EXTERNAL_NET, not HOME_NET <-> HOME_NET).
alert http any any -> any any (msg:"LOCAL VALIDATION - HTTP Traffic Detected"; flow:established,to_server; sid:9999999; rev:1;)

# ── Custom WireGuard behavioral detection rules ──────────────────────────────
# These rules detect WireGuard by packet structure, NOT by port number.
# This is meaningful because obfuscation tools (udp2raw, obfs4) prevent these
# from firing — proving protocol-level obfuscation defeats behavioral detection.
#
# WireGuard Handshake Initiator (RFC-style message type 0x01):
#   Byte 0:    0x01  (message type = Initiator)
#   Bytes 1-3: 0x00 0x00 0x00 (reserved, always zero per spec)
#   Total UDP payload: 148 bytes
#   Layout: type(1) + reserved(3) + sender_idx(4) + ephemeral_pub(32)
#           + encrypted_static(48) + encrypted_timestamp(28) + mac1(16) + mac2(16)
alert udp any any -> any any (msg:"CUSTOM WireGuard Handshake Initiator (behavioral, port-independent)"; dsize:148; content:"|01 00 00 00|"; offset:0; depth:4; classtype:policy-violation; sid:9000001; rev:1;)

# WireGuard Handshake Response (message type 0x02):
#   Byte 0:    0x02  (message type = Responder)
#   Bytes 1-3: 0x00 0x00 0x00 (reserved, always zero per spec)
#   Total UDP payload: 92 bytes
#   Layout: type(1) + reserved(3) + sender_idx(4) + receiver_idx(4)
#           + ephemeral_pub(32) + encrypted_nothing(16) + mac1(16) + mac2(16)
alert udp any any -> any any (msg:"CUSTOM WireGuard Handshake Response (behavioral, port-independent)"; dsize:92; content:"|02 00 00 00|"; offset:0; depth:4; classtype:policy-violation; sid:9000002; rev:1;)
