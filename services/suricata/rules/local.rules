# Old rule (inner HTTP - not visible due to encryption)
# alert http any any -> 172.30.30.10 any (msg:"VPN-LAB HTTP to target"; sid:1000001; rev:1;)

# Baseline: Detect WireGuard Traffic (UDP 51820)
alert udp any any -> any 51820 (msg:"VPN-LAB WireGuard Traffic Detected"; sid:1000002; rev:1;)

# UDP2RAW: Detect TCP 443 Traffic (Obfuscated)
alert tcp any any -> any 443 (msg:"VPN-LAB UDP2RAW/HTTPS Traffic Detected"; sid:1000003; rev:1;)

# OBFS4: Detect OBFS4 Traffic (TCP 12345)
alert tcp any any -> any 12345 (msg:"VPN-LAB OBFS4 Traffic Detected"; sid:1000004; rev:1;)