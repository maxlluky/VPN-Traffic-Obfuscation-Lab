############################
# Cryptographic material (never commit)
############################
# Ignore only sensitive WireGuard files (private keys, QR codes, etc.)
# but allow wg0.conf and templates to be tracked for easy project setup

# Private/public key pairs (generated at runtime)
**/privatekey-*
**/publickey-*
**/presharedkey-*

# QR code images (contain private keys)
**/*.png
!docs/*.png

# LinuxServer.io WireGuard container metadata
**/.donoteditthisfile

# Keep all configs and templates tracked
# - wg0.conf files
# - *.template files  
# - custom-cont-init.d scripts
# - wg_confs/ directories

############################
# Environment / secrets
############################
# Local environment files (never commit)
.env
.env.*
!.env.example

############################
# Packet captures (experimental artefacts)
############################
pcaps/
*.pcap
*.pcapng

############################
# Experimental results / artefacts
############################
results/

############################
# Temporary / generated files
############################
tmp/
build/
*~
iperf_output.json

############################
# Editor / OS noise
############################
.vscode/
.idea/
.DS_Store
*.swp
*.swo

############################
# Python & Analysis
############################
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
env/
analysis/*.csv
analysis/*.png